{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "paths": {
      "@ysc/core": ["../packages/ysc-core/src/index.ts"],
      "@ysc/core/*": ["../packages/ysc-core/src/*"]
    }
  },
  "include": ["src/**/*", "../packages/ysc-core/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "../packages/ysc-core/src/**/*.vue", "../packages/ysc-core/src/**/*.test.ts"]
}
