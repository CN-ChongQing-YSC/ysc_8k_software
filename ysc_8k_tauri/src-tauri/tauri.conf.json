{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YSC 8K 驱动",
  "version": "2.1.0",
  "identifier": "com.ysc.8k-driver",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "devUrl": "http://127.0.0.1:5179",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YSC 8K 驱动",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "backgroundColor": "#0f1117"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "resources/installer-hooks.nsh"
      }
    }
  }
}
